# --- Store: Postgres + pgvector, single store ---
# docker compose overrides this to point at its own `postgres` service.
# This localhost URL is for running the app or evals outside compose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Model provider: OpenAI ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-5.4-mini

# --- Azure Document Intelligence (PDF/DOCX/XLSX/PPTX/HTML/image parsing) ---
AZURE_DI_ENDPOINT=https://doc-intelligence-serve.cognitiveservices.azure.com/
AZURE_DI_KEY=

# --- MCP server auth — two role keys, not one shared key ---
# Each may list several comma-separated keys
MCP_API_KEY_EMPLOYEE=
MCP_API_KEY_MANAGER=
MCP_RATE_LIMIT_PER_MINUTE=300
# Host header(s) the Streamable-HTTP transport will accept.
# Required on Azure/ACA -- the SDK's DNS-rebinding check 421s any non-matching Host.
PUBLIC_HOST=localhost:8000

# --- Retrieval ---
RELEVANCE_FLOOR=0.25
HYBRID_SEARCH=true