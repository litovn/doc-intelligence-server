        <mxCell id="ui" value="&lt;b&gt;/&lt;/b&gt; &amp;nbsp;&lt;b&gt;Web UI — Next.js 16&lt;/b&gt;&lt;br&gt;static export · React 19 · TypeScript&lt;br&gt;built in node:22-slim, served by FastAPI StaticFiles&lt;br&gt;&lt;br&gt;Login · Documents · Tags · Chat" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="stack">
