        <mxCell id="agent" value="&lt;b&gt;Chat agent — Microsoft Agent Framework&lt;/b&gt;&lt;br&gt;(agent-framework-openai)&lt;br&gt;model ↔ tool loop, max 6 tool calls,&lt;br&gt;then tool_choice = none&lt;br&gt;tools via &lt;b&gt;in-memory MCP client&lt;/b&gt;&lt;br&gt;(no HTTP, no key, level from session)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="stack">
